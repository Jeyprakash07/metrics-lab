        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(shop_http_request_duration_seconds_sum{job=\"order-service\", instance=~\"$instance\"}[$__rate_interval])) / sum(rate(shop_http_request_duration_seconds_count{job=\"order-service\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "mean (_sum/_count)"
        }
