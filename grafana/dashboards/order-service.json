      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(shop_queue_depth{job=\"order-service\", instance=~\"$instance\"})",
          "legendFormat": "__auto",
